@model IEnumerable<ProductionManagementSystem.Models.ProductionEntry>

@{
    ViewData["Title"] = "Production Entries";
}

<h1 class="mb-4 text-primary fw-bold">🏭 Production Entries</h1>

<p>
    <a asp-action="Create" class="btn btn-success shadow">
        ➕ Add Production Entry
    </a>
</p>

<table class="table table-bordered table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Product Name</th>
            <th>Quantity Produced</th>
            <th>Entry Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.QuantityProduced</td>
                <td>@item.EntryDate.ToShortDateString()</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
