<h1 class="mb-4 fw-bold text-primary">📊 Dashboard</h1>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow-lg border-0 rounded-4 bg-primary text-white">
            <div class="card-body text-center">
                <h5>Total Materials</h5>
                <h1>@ViewBag.TotalMaterials</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-lg border-0 rounded-4 bg-danger text-white">
            <div class="card-body text-center">
                <h5>Low Stock</h5>
                <h1>@ViewBag.LowStock</h1>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-lg border-0 rounded-4 bg-success text-white">
            <div class="card-body text-center">
                <h5>Total Quantity</h5>
                <h1>@ViewBag.TotalQuantity</h1>
            </div>
        </div>
    </div>


</div>

<div class="mt-4">
    <a href="/Materials/Index" class="btn btn-primary btn-lg">View Materials</a>
    <a href="/Materials/Create" class="btn btn-success btn-lg">Add Material</a>
</div>
<div class="row mt-5">

    <div class="col-md-6">
        <div class="card shadow p-3">
            <h5>Stock Quantity Chart</h5>
            <canvas id="barChart"></canvas>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow p-3">
            <h5>Stock Status</h5>
            <canvas id="pieChart"></canvas>
        </div>
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var names = @Html.Raw(Json.Serialize(ViewBag.MaterialNames));
    var qty = @Html.Raw(Json.Serialize(ViewBag.MaterialQty));

    const barChart = new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: names,
            datasets: [{
                label: 'Stock Quantity',
                data: qty,
                backgroundColor: ['blue','green','orange','red','purple']
            }]
        }
    });

    const pieChart = new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
            labels: ['Available', 'Low Stock'],
            datasets: [{
                data: [@ViewBag.TotalMaterials - @ViewBag.LowStock, @ViewBag.LowStock],
                backgroundColor: ['green','red']
            }]
        }
    });
</script>